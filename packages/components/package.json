{
  "name": "@onec/components",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Web Components du design system onec (Stencil).",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "files": [
    "dist",
    "loader"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*"
    }
  },
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@onec/icons": "workspace:*",
    "@onec/tokens": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@fontsource/open-sans": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@stencil/angular-output-target": "1.6.0",
    "@stencil/core": "4.45.5",
    "@stencil/react-output-target": "1.8.1",
    "@stencil/sass": "^3.3.3",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/web-components-vite": "10.6.9",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "lit": "^3.3.3",
    "remark-gfm": "^4.0.1",
    "storybook": "10.6.9",
    "vite": "^8.3.8"
  }
}
