{
  "name": "@onec/icons",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Icônes Lucide en SVG sources pour le design system onec.",
  "type": "module",
  "files": [
    "dist",
    "svg",
    "LICENSE-lucide"
