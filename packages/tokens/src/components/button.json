            "$value": "{color.text.disabled}"
          }
        }
      },
      "info": {
        "background": {
          "default": {
            "$value": "{color.transparent}"
          },
          "hover": {
            "$value": "{color.action.info.tint-hover}"
          },
          "active": {
            "$value": "{color.action.info.tint-active}"
          },
          "disabled": {
            "$value": "{color.transparent}"
          }
        },
        "border": {
          "default": {
            "$value": "{color.transparent}"
          },
          "hover": {
            "$value": "{color.transparent}"
          },
          "active": {
            "$value": "{color.transparent}"
          },
          "disabled": {
            "$value": "{color.transparent}"
          }
        },
        "foreground": {
          "default": {
            "$value": "{color.action.info.text}"
          },
          "hover": {
            "$value": "{color.action.info.text}"
          },
          "active": {
            "$value": "{color.action.info.text}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        }
      }
    }
  }
}
