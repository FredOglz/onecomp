        "text": {
          "$value": "{color.palette.amber.700}"
        },
        "tint-hover": {
          "$value": "{color.palette.amber.50}"
        },
        "tint-active": {
          "$value": "{color.palette.amber.100}"
        },
        "border": {
          "$value": "{color.palette.amber.600}"
        }
      },
      "error": {
        "fill": {
          "$value": "{color.palette.red.600}"
        },
        "fill-hover": {
          "$value": "{color.palette.red.700}"
        },
        "fill-active": {
          "$value": "{color.palette.red.800}"
        },
        "on-fill": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.palette.red.700}"
        },
        "tint-hover": {
          "$value": "{color.palette.red.50}"
        },
        "tint-active": {
          "$value": "{color.palette.red.100}"
        },
        "border": {
          "$value": "{color.palette.red.600}"
        }
      },
      "info": {
        "fill": {
          "$value": "{color.palette.blue.600}"
        },
        "fill-hover": {
          "$value": "{color.palette.blue.700}"
        },
        "fill-active": {
          "$value": "{color.palette.blue.800}"
        },
        "on-fill": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.palette.blue.700}"
        },
        "tint-hover": {
          "$value": "{color.palette.blue.50}"
        },
        "tint-active": {
          "$value": "{color.palette.blue.100}"
        },
        "border": {
          "$value": "{color.palette.blue.600}"
        }
      }
    }
  }
}
